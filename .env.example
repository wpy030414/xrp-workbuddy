# —— 服务 ——
WORKBUDDY_PORT=19069
XRL_ROUTER_URL=http://localhost:19068

# —— WorkBuddy 网关 ——
# 推理网关：对话 / 模型目录 / 刷新
WORKBUDDY_BASE_URL=https://copilot.tencent.com
# 登录网关：网页登录握手与换票（与推理网关共用同一 state 存储，填哪个都行）
WORKBUDDY_AUTH_BASE_URL=https://www.workbuddy.cn
WORKBUDDY_DOMAIN=www.workbuddy.cn
WORKBUDDY_IDE_VERSION=5.8.3
WORKBUDDY_PLATFORM=workbuddy

# —— 自包含凭证存储 ——
# 凭证文件路径（默认落在用户数据目录，不进 git）
# WORKBUDDY_CREDENTIAL_PATH=
# 存储形态：auto（默认，Win 用 DPAPI / 其它平台见下）| dpapi | aes | plain
# WORKBUDDY_STORE_MODE=auto
# AES 模式的 passphrase；设置后 auto 模式优先使用 AES（跨平台可迁移）
# 注意：.env 永不提交，切勿写明文密钥到仓库
# WORKBUDDY_AUTH_SECRET=

# —— 登录行为 ——
# 无有效登录态时，服务是否自动发起网页登录（会弹浏览器）。默认关闭：
# 关闭时服务不会静默弹浏览器，请用 `pnpm login` 显式登录后再 serve。
# WORKBUDDY_AUTO_LOGIN=0

# —— 模型列表（逗号分隔；留空 = 启动时从网关目录动态拉取全部文本模型）——
# WORKBUDDY_MODELS=auto,glm-5.3,glm-5.3-flash,kimi-k3-1,deepseek-v4-pro

# —— 旧版兼容（可选，默认关闭）——
# 开启后，插件会额外读取并解密本机 WorkBuddy App 的登录态文件（需已安装 WorkBuddy）。
# 自包含网页登录已可独立运行，通常无需开启。
# WORKBUDDY_USE_LEGACY_APP=0
# WORKBUDDY_AUTH_PATH=%LOCALAPPDATA%\CodeBuddyExtension\Data\Public\auth\workbuddy-desktop.info
# WORKBUDDY_APP_PATH=C:\Program Files\WorkBuddy\WorkBuddy.exe

# —— 灾备凭证（可选：无任何登录态时使用；注意 .env 永不提交）——
# WORKBUDDY_ACCESS_TOKEN=
# WORKBUDDY_REFRESH_TOKEN=
# WORKBUDDY_USER_ID=
