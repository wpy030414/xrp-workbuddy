# —— 服务 ——
WORKBUDDY_PORT=19069
XRL_ROUTER_URL=http://localhost:19068

# —— WorkBuddy 网关 ——
# 官方端点：https://copilot.tencent.com / https://www.workbuddy.cn
WORKBUDDY_BASE_URL=https://copilot.tencent.com
WORKBUDDY_DOMAIN=www.workbuddy.cn
WORKBUDDY_IDE_VERSION=5.8.3

# —— 本机登录态（默认自动探测，一般无需填写）——
# Windows: %LOCALAPPDATA%\CodeBuddyExtension\Data\Public\auth\workbuddy-desktop.info
# macOS:   ~/Library/Application Support/CodeBuddyExtension/Data/Public/auth/workbuddy-desktop.info
# WORKBUDDY_AUTH_PATH=
# WORKBUDDY_APP_PATH=C:\Program Files\WorkBuddy\WorkBuddy.exe

# —— 模型列表（逗号分隔；留空 = 启动时从网关目录动态拉取全部文本模型）——
# WORKBUDDY_MODELS=auto,glm-5.3,glm-5.3-flash,kimi-k3-1,deepseek-v4-pro

# —— 灾备凭证（可选：auth 文件不可用时使用；注意 .env 永不提交）——
# WORKBUDDY_ACCESS_TOKEN=
# WORKBUDDY_REFRESH_TOKEN=
# WORKBUDDY_USER_ID=
